:root {
}

.shipName_style {
    position: relative;
    left: auto;
    bottom: auto;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-self: auto;
    align-items: auto;
    -unity-text-align: middle-left;
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/TriLauAsset/Fonts/nasalization/Nasalization%20Rg.otf?fileID=12800000&guid=25d21547291532f4482bcda1fc8b6c70&type=3#Nasalization Rg");
    color: rgb(255, 255, 255);
    visibility: visible;
    overflow: hidden;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

.shipName_style_hiden {
    transform-origin: center;
    translate: -100% 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}
