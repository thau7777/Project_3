    <ui:Template name="SoundPanel" src="project://database/Assets/TriLauAsset/UI%20Toolkit/Uxml/MainMenu/SoundPanel.uxml?fileID=9197481963319205126&amp;guid=777d3235f20a4ae4b9ebc4478659ff4c&amp;type=3#SoundPanel"/>
    <Style src="project://database/Assets/TriLauAsset/UI%20Toolkit/Uss/settingPanel_style.uss?fileID=7433441132597879392&amp;guid=1027981b08d441e4fbc29dbddfe36b63&amp;type=3#settingPanel_style"/>
    <Style src="project://database/Assets/TriLauAsset/UI%20Toolkit/Uss/button_style.uss?fileID=7433441132597879392&amp;guid=90d616873fe73c641a14f52fc7906be5&amp;type=3#button_style"/>
    <ui:VisualElement name="SettingsPanel" enabled="true" style="width: 100%; height: 100%; transition-duration: 1s; transition-timing-function: ease-in-out-elastic; overflow: visible; visibility: visible;">
        <ui:VisualElement name="OptionsTabView" style="flex-grow: 1; width: 100%; height: 10%; flex-direction: row; justify-content: space-around; align-items: center; align-self: center; align-content: auto;">
            <ui:VisualElement style="flex-grow: 1; width: auto; align-self: center; align-items: stretch; align-content: flex-start; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
                <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/TriLauAsset/Textures/Xbox%20Series%20Button%20Icons%20and%20Controls/Buttons%20Outline/White/512w/Left%20Bumper.png?fileID=2800000&amp;guid=f1877ccd4a48f324c8d4d694a3611181&amp;type=3#Left Bumper&quot;); width: 100px; height: 100px; -unity-background-scale-mode: stretch-to-fill; rotate: 0; justify-content: space-around; align-self: center; align-content: auto; padding-right: 0; padding-bottom: 0; padding-top: 0; padding-left: 0; margin-right: 0; margin-left: 0; position: relative; align-items: stretch; -unity-background-image-tint-color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:Button text="General" name="GeneralButton" class="button_tab" style="width: 300px;"/>
            <ui:Button text="Graphic" name="GraphicButton" class="button_tab" style="width: 300px;"/>
            <ui:Button text="Sound" name="SoundButton" class="button_tab" style="height: 80px; width: 300px; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0.12); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgba(99, 0, 255, 0.24); border-right-color: rgba(99, 0, 255, 0.24); border-top-color: rgba(99, 0, 255, 0.24); border-bottom-color: rgba(99, 0, 255, 0.24); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 36px; color: rgb(255, 255, 255); padding-right: 10px; padding-left: 10px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; background-color: rgba(188, 188, 188, 0); -unity-font-definition: url(&quot;project://database/Assets/TriLauAsset/Fonts/neuropol/Neuropol.otf?fileID=12800000&amp;guid=e1d32f9b6ca28ba498d1e0c6542e1938&amp;type=3#Neuropol&quot;); justify-content: center; align-self: center;"/>
            <ui:Button text="Console" name="ConsoleButton" class="button_tab" style="height: 80px; width: 300px; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0.12); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgba(99, 0, 255, 0.24); border-right-color: rgba(99, 0, 255, 0.24); border-top-color: rgba(99, 0, 255, 0.24); border-bottom-color: rgba(99, 0, 255, 0.24); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 36px; color: rgb(255, 255, 255); padding-right: 10px; padding-left: 10px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; background-color: rgba(188, 188, 188, 0); -unity-font-definition: url(&quot;project://database/Assets/TriLauAsset/Fonts/neuropol/Neuropol.otf?fileID=12800000&amp;guid=e1d32f9b6ca28ba498d1e0c6542e1938&amp;type=3#Neuropol&quot;); justify-content: center; align-self: center;"/>
            <ui:Button text="Keyboard" name="KeyboardButton" class="button_tab" style="height: 80px; width: 300px; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0.12); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgba(99, 0, 255, 0.24); border-right-color: rgba(99, 0, 255, 0.24); border-top-color: rgba(99, 0, 255, 0.24); border-bottom-color: rgba(99, 0, 255, 0.24); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 36px; color: rgb(255, 255, 255); padding-right: 10px; padding-left: 10px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; background-color: rgba(188, 188, 188, 0); -unity-font-definition: url(&quot;project://database/Assets/TriLauAsset/Fonts/neuropol/Neuropol.otf?fileID=12800000&amp;guid=e1d32f9b6ca28ba498d1e0c6542e1938&amp;type=3#Neuropol&quot;); justify-content: center; align-self: center;"/>
            <ui:VisualElement style="flex-grow: 1; margin-left: 0; width: auto;">
                <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/TriLauAsset/Textures/Xbox%20Series%20Button%20Icons%20and%20Controls/Buttons%20Outline/White/512w/Right%20Bumper.png?fileID=2800000&amp;guid=293031f44bc368c46963842831061595&amp;type=3#Right Bumper&quot;); width: 100px; height: 100px; -unity-background-scale-mode: stretch-to-fill; rotate: 0; position: relative; flex-direction: column; align-self: center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="OptionPanel" style="flex-grow: 1; width: 100%; height: 90%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; visibility: visible;">
            <ui:VisualElement name="Content" style="flex-grow: 1; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0.12); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(99, 0, 255, 0.24); border-right-color: rgba(99, 0, 255, 0.24); border-top-color: rgba(99, 0, 255, 0.24); border-bottom-color: rgba(99, 0, 255, 0.24); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 80px; padding-right: 100px; padding-bottom: 80px; padding-left: 100px; visibility: visible; align-self: center; justify-content: center; align-items: center;">
                <ui:Instance template="GeneralPanel" name="GeneralPanel" style="width: 90%; height: 90%; position: absolute; visibility: visible; overflow: visible;"/>
                <ui:Instance template="GraphicPanel" name="GraphicPanel" style="position: absolute; height: 90%; width: 90%; left: 110%; top: auto; overflow: visible; visibility: visible; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-slice-type: sliced;"/>
                <ui:Instance template="SoundPanel" name="SoundPanel" style="width: 90%; height: 90%; position: absolute; left: 110%;"/>
                <ui:Instance template="ConsolePanel" name="ConsolePanel" style="left: 110%; width: 90%; height: 90%; position: absolute;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
