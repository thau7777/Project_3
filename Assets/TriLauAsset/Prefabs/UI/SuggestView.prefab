  m_Script: {fileID: 11500000, guid: d0b3ebb610460174589584754c2e2750, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MyRule.SuggestView
  canvasGroup: {fileID: 3642200880776370787}
  images:
  - {fileID: 3802234564649538935}
  - {fileID: 3081790256823987965}
  - {fileID: 3748092260813953865}
  - {fileID: 6971196405855146686}
  - {fileID: 6518939755572148875}
  - {fileID: 2286046651046631749}
  text: {fileID: 5040347688473428024}
  suggestDes:
  - At the beginning of each match or after winning a combat, you can receive one
    of three sigils that can be retrieved from the pool. [Left-click] to select a
    sigil.
  - You can also [Right-click] to see the details of that sigil.
  - The HUD bar below will display basic information such as health, runes, sigil
    storage, and items.
  - The Q, E, R, and F slots are sigil slots for top-down games, while the top 8
    slots are sigil slots for turn-based games. You can hold down the left mouse
    button to swap the sigil slots in these slots. The slots below are for stat-boosting
    sigils. You can press the [E]/[R] keys to toggle these storage slots on and off.
  - You can press [Tab] to open the character stats display panel.
  - You can [Left-click] to select event nodes.
  continueBtn: {fileID: 6189321624854646951}
